rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOrganizer() {
      return isAuthenticated() &&
        (request.auth.uid == 'REPLACE_WITH_DEVELOPER_UID' ||
          get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.role in ['organizer', 'admin']);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.uid == 'REPLACE_WITH_DEVELOPER_UID' ||
          get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.role == 'admin');
    }

    function isMember() {
      return isOrganizer() || (isAuthenticated() &&
        get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.visionCastingAccepted == true);
    }

    // Temporary migration access for profiles created before the privacy split.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users_public/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        ((request.resource.data.role == 'student' &&
          request.resource.data.visionCastingAccepted == false &&
          request.resource.data.membershipStatus == 'PENDING') ||
          (request.resource.data.role == 'organizer' &&
            request.auth.uid == 'REPLACE_WITH_DEVELOPER_UID' &&
            request.resource.data.visionCastingAccepted == true &&
            request.resource.data.membershipStatus == 'APPROVED'));
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'faculty', 'course', 'yearOfStudy']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.visionCastingAccepted == resource.data.visionCastingAccepted &&
        request.resource.data.membershipStatus == resource.data.membershipStatus;
      allow update: if isOrganizer() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'visionCastingAccepted', 'membershipStatus', 'approvedByUid',
          'approvedByEmail', 'approvedAt'
        ]) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.visionCastingAccepted is bool &&
        request.resource.data.membershipStatus in ['PENDING', 'APPROVED', 'REJECTED', 'FILTERED'] &&
        (!('approvedByUid' in request.resource.data) || request.resource.data.approvedByUid is string) &&
        (!('approvedByEmail' in request.resource.data) || request.resource.data.approvedByEmail is string) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt is timestamp);
      allow update: if isAuthenticated() &&
        isAdmin() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
        request.resource.data.role in ['student', 'organizer', 'admin'] &&
        request.resource.data.visionCastingAccepted == resource.data.visionCastingAccepted &&
        request.resource.data.membershipStatus == resource.data.membershipStatus;
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /users_private/{userId} {
      allow read: if isOwner(userId) || isOrganizer();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string;
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /semesters/{semesterId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    match /availabilities/{availabilityId} {
      allow read: if isOrganizer() ||
        (isMember() && availabilityId.matches('^' + request.auth.uid + '_.*'));
      allow create: if isMember() &&
        availabilityId == request.auth.uid + '_' + request.resource.data.semesterId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.semesterId is string &&
        request.resource.data.slots is list;
      allow update: if isMember() &&
        availabilityId == request.auth.uid + '_' + resource.data.semesterId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.semesterId == resource.data.semesterId &&
        request.resource.data.slots is list;
      allow delete: if isMember() &&
        resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isOrganizer() &&
        request.resource.data.name is string &&
        request.resource.data.dates is list &&
        request.resource.data.dates.size() > 0 &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByName is string;
      allow update: if isOrganizer() &&
        (resource.data.createdByUid == request.auth.uid || isAdmin()) &&
        request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isOrganizer() &&
        (resource.data.createdByUid == request.auth.uid || isAdmin());
    }

    match /eventSignups/{signupId} {
      allow read: if isOrganizer() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isMember() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.eventId is string &&
        request.resource.data.date is string &&
        request.resource.data.slot is string;
      allow delete: if isOrganizer() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    match /eventPairings/{pairingId} {
      allow read: if isMember();
      allow create, update: if isOrganizer() &&
        request.resource.data.eventId is string &&
        request.resource.data.slotId is string &&
        (request.resource.data.createdByUid == request.auth.uid || isAdmin()) &&
        request.resource.data.groups is list;
      allow delete: if isOrganizer() &&
        (resource.data.createdByUid == request.auth.uid || isAdmin());
    }

    function hasNoJourneyProgress(data) {
      return (!('vision_cast' in data.followUpProgress) || !data.followUpProgress.vision_cast) &&
        (!('jof1_1' in data.followUpProgress) || !data.followUpProgress.jof1_1) &&
        (!('jof1_2' in data.followUpProgress) || !data.followUpProgress.jof1_2) &&
        (!('jof1_3' in data.followUpProgress) || !data.followUpProgress.jof1_3) &&
        (!('jof1_4' in data.followUpProgress) || !data.followUpProgress.jof1_4) &&
        (!('jof1_5' in data.followUpProgress) || !data.followUpProgress.jof1_5) &&
        (!('jof1_6' in data.followUpProgress) || !data.followUpProgress.jof1_6) &&
        (!('jof1_7' in data.followUpProgress) || !data.followUpProgress.jof1_7) &&
        (!('jof1_8' in data.followUpProgress) || !data.followUpProgress.jof1_8);
    }

    function validContact(data) {
      return data.keys().hasOnly([
          'createdById', 'createdByName', 'name', 'phoneNumber', 'gender',
          'photoUrl', 'gospelStatus', 'responseStatuses', 'followUpProgress',
          'remarks', 'createdAt', 'updatedAt', 'linkedUserId', 'linkedAt', 'linkedByUid'
        ]) &&
        data.createdById is string && data.createdByName is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.gender in ['male', 'female'] &&
        data.gospelStatus in ['not_started', 'gospel_conversation', 'gospel_presentation'] &&
        data.responseStatuses is list && data.responseStatuses.size() <= 4 &&
        data.responseStatuses.hasOnly([
          'pray_receive_christ', 'already_christian', 'not_ready', 'say_yes_follow_up'
        ]) &&
        data.followUpProgress is map &&
        data.followUpProgress.keys().hasOnly([
          'vision_cast', 'jof1_1', 'jof1_2', 'jof1_3', 'jof1_4',
          'jof1_5', 'jof1_6', 'jof1_7', 'jof1_8'
        ]) &&
        (!('vision_cast' in data.followUpProgress) || data.followUpProgress.vision_cast is bool) &&
        (!('jof1_1' in data.followUpProgress) || data.followUpProgress.jof1_1 is bool) &&
        (!('jof1_2' in data.followUpProgress) || data.followUpProgress.jof1_2 is bool) &&
        (!('jof1_3' in data.followUpProgress) || data.followUpProgress.jof1_3 is bool) &&
        (!('jof1_4' in data.followUpProgress) || data.followUpProgress.jof1_4 is bool) &&
        (!('jof1_5' in data.followUpProgress) || data.followUpProgress.jof1_5 is bool) &&
        (!('jof1_6' in data.followUpProgress) || data.followUpProgress.jof1_6 is bool) &&
        (!('jof1_7' in data.followUpProgress) || data.followUpProgress.jof1_7 is bool) &&
        (!('jof1_8' in data.followUpProgress) || data.followUpProgress.jof1_8 is bool) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
        (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 2000)) &&
        (!('linkedUserId' in data) || data.linkedUserId is string) &&
        (!('linkedAt' in data) || data.linkedAt is timestamp) &&
        (!('linkedByUid' in data) || data.linkedByUid is string) &&
        (!('photoUrl' in data) || data.photoUrl == null) &&
        (data.gospelStatus != 'not_started' || (data.responseStatuses.size() == 0 && hasNoJourneyProgress(data))) &&
        (!data.responseStatuses.hasAny(['not_ready']) ||
          (data.responseStatuses.size() == 1 && hasNoJourneyProgress(data))) &&
        (hasNoJourneyProgress(data) ||
          data.responseStatuses.hasAny(['say_yes_follow_up']));
    }

    match /contacts/{contactId} {
      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.createdById == request.auth.uid &&
        validContact(request.resource.data);
      allow update: if isMember() &&
        isOrganizer() &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.createdByName == resource.data.createdByName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validContact(request.resource.data);
      allow update: if isMember() &&
        isOwner(resource.data.createdById) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedUserId', 'linkedAt', 'linkedByUid']) &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.createdByName == resource.data.createdByName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validContact(request.resource.data);
      allow update: if isMember() &&
        isOwner(resource.data.linkedByUid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['linkedUserId', 'linkedAt', 'linkedByUid']) &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.createdByName == resource.data.createdByName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validContact(request.resource.data);
      allow update: if isMember() &&
        isOwner(resource.data.linkedByUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUserId', 'linkedAt', 'linkedByUid', 'updatedAt']) &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.createdByName == resource.data.createdByName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validContact(request.resource.data);
      allow delete: if isMember() &&
        (isOwner(resource.data.createdById) || isOrganizer());
    }
  }
}
