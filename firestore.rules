rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOrganizer() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.role == 'organizer';
    }

    // Temporary migration access for profiles created before the privacy split.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users_public/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role == 'student' ||
          (request.resource.data.role == 'organizer' &&
            get(/databases/$(database)/documents/users/$(userId)).data.role == 'organizer'));
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /users_private/{userId} {
      allow read: if isOwner(userId) || isOrganizer();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string;
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /semesters/{semesterId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    match /availabilities/{availabilityId} {
      allow read: if isOrganizer() ||
        (isAuthenticated() && availabilityId.matches('^' + request.auth.uid + '_.*'));
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }
  }
}
