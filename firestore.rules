rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOrganizer() {
      return isAuthenticated() &&
        (request.auth.uid == 'REPLACE_WITH_DEVELOPER_UID' ||
          get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.role in ['organizer', 'admin']);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.uid == 'REPLACE_WITH_DEVELOPER_UID' ||
          get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.role == 'admin');
    }

    function isMember() {
      return isOrganizer() || (isAuthenticated() &&
        get(/databases/$(database)/documents/users_public/$(request.auth.uid)).data.visionCastingAccepted == true);
    }

    function validStringListItem(values, index, maxLength) {
      return values.size() <= index ||
        (values[index] is string &&
          values[index].size() > 0 &&
          values[index].size() <= maxLength);
    }

    function validOutreachPartnerFields(data) {
      return (!('outreachPartnerIds' in data) && !('outreachPartnerNames' in data)) ||
        ('outreachPartnerIds' in data &&
          'outreachPartnerNames' in data &&
          data.outreachPartnerIds is list &&
          data.outreachPartnerNames is list &&
          data.outreachPartnerIds.size() <= 10 &&
          data.outreachPartnerNames.size() <= 10 &&
          data.outreachPartnerIds.size() == data.outreachPartnerNames.size() &&
          validStringListItem(data.outreachPartnerIds, 0, 128) &&
          validStringListItem(data.outreachPartnerIds, 1, 128) &&
          validStringListItem(data.outreachPartnerIds, 2, 128) &&
          validStringListItem(data.outreachPartnerIds, 3, 128) &&
          validStringListItem(data.outreachPartnerIds, 4, 128) &&
          validStringListItem(data.outreachPartnerIds, 5, 128) &&
          validStringListItem(data.outreachPartnerIds, 6, 128) &&
          validStringListItem(data.outreachPartnerIds, 7, 128) &&
          validStringListItem(data.outreachPartnerIds, 8, 128) &&
          validStringListItem(data.outreachPartnerIds, 9, 128) &&
          validStringListItem(data.outreachPartnerNames, 0, 80) &&
          validStringListItem(data.outreachPartnerNames, 1, 80) &&
          validStringListItem(data.outreachPartnerNames, 2, 80) &&
          validStringListItem(data.outreachPartnerNames, 3, 80) &&
          validStringListItem(data.outreachPartnerNames, 4, 80) &&
          validStringListItem(data.outreachPartnerNames, 5, 80) &&
          validStringListItem(data.outreachPartnerNames, 6, 80) &&
          validStringListItem(data.outreachPartnerNames, 7, 80) &&
          validStringListItem(data.outreachPartnerNames, 8, 80) &&
          validStringListItem(data.outreachPartnerNames, 9, 80));
    }

    function autoApproveMembersEnabled() {
      return exists(/databases/$(database)/documents/app_settings/main) &&
        get(/databases/$(database)/documents/app_settings/main).data.autoApproveMembers == true;
    }

    // Temporary migration access for profiles created before the privacy split.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users_public/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        ((request.resource.data.role == 'student' &&
          ((!autoApproveMembersEnabled() &&
            request.resource.data.visionCastingAccepted == false &&
            request.resource.data.membershipStatus == 'PENDING') ||
            (autoApproveMembersEnabled() &&
              request.resource.data.visionCastingAccepted == true &&
              request.resource.data.membershipStatus == 'APPROVED'))) ||
          (request.resource.data.role == 'organizer' &&
            request.auth.uid == 'REPLACE_WITH_DEVELOPER_UID' &&
            request.resource.data.visionCastingAccepted == true &&
            request.resource.data.membershipStatus == 'APPROVED'));
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'faculty', 'course', 'yearOfStudy']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.visionCastingAccepted == resource.data.visionCastingAccepted &&
        request.resource.data.membershipStatus == resource.data.membershipStatus;
      allow update: if isOrganizer() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'visionCastingAccepted', 'membershipStatus', 'approvedByUid',
          'approvedByEmail', 'approvedAt', 'photoURL'
        ]) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.visionCastingAccepted is bool &&
        request.resource.data.membershipStatus in ['PENDING', 'APPROVED', 'REJECTED', 'FILTERED'] &&
        (!('approvedByUid' in request.resource.data) || request.resource.data.approvedByUid is string) &&
        (!('approvedByEmail' in request.resource.data) || request.resource.data.approvedByEmail is string) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt is timestamp) &&
        (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string);
      allow update: if isAuthenticated() &&
        isAdmin() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
        request.resource.data.role in ['student', 'organizer', 'admin'] &&
        request.resource.data.visionCastingAccepted == resource.data.visionCastingAccepted &&
        request.resource.data.membershipStatus == resource.data.membershipStatus;
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /users_private/{userId} {
      allow read: if isOwner(userId) || isOrganizer();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string;
      allow update: if isOwner(userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /app_settings/{configId} {
      allow read: if isAuthenticated();
      allow create, update: if isOrganizer() &&
        configId == 'main' &&
        request.resource.data.keys().hasOnly(['autoApproveMembers', 'updatedAt']) &&
        request.resource.data.autoApproveMembers is bool &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /semesters/{semesterId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    match /availabilities/{availabilityId} {
      allow read: if isOrganizer() ||
        (isMember() && availabilityId.matches('^' + request.auth.uid + '_.*'));
      allow create: if isMember() &&
        availabilityId == request.auth.uid + '_' + request.resource.data.semesterId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.semesterId is string &&
        request.resource.data.slots is list;
      allow update: if isMember() &&
        availabilityId == request.auth.uid + '_' + resource.data.semesterId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.semesterId == resource.data.semesterId &&
        request.resource.data.slots is list;
      allow delete: if isMember() &&
        resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isOrganizer() &&
        request.resource.data.name is string &&
        request.resource.data.dates is list &&
        request.resource.data.dates.size() > 0 &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByName is string;
      allow update: if isOrganizer() &&
        (resource.data.createdByUid == request.auth.uid || isAdmin()) &&
        request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isOrganizer() &&
        (resource.data.createdByUid == request.auth.uid || isAdmin());
    }

    match /eventSignups/{signupId} {
      allow read: if isOrganizer() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isMember() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.eventId is string &&
        request.resource.data.date is string &&
        request.resource.data.slot is string;
      allow delete: if isOrganizer() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    match /eventPairings/{pairingId} {
      allow read: if isMember();
      allow create, update: if isOrganizer() &&
        request.resource.data.eventId is string &&
        request.resource.data.slotId is string &&
        request.resource.data.createdByUid is string &&
        request.resource.data.groups is list;
      allow delete: if isOrganizer() &&
        (resource.data.createdByUid == request.auth.uid || isAdmin());
    }

    function hasNoJourneyProgress(data) {
      return (!('vision_cast' in data.followUpProgress) || !data.followUpProgress.vision_cast) &&
        (!('jof1_1' in data.followUpProgress) || !data.followUpProgress.jof1_1) &&
        (!('jof1_2' in data.followUpProgress) || !data.followUpProgress.jof1_2) &&
        (!('jof1_3' in data.followUpProgress) || !data.followUpProgress.jof1_3) &&
        (!('jof1_4' in data.followUpProgress) || !data.followUpProgress.jof1_4) &&
        (!('jof1_5' in data.followUpProgress) || !data.followUpProgress.jof1_5) &&
        (!('jof1_6' in data.followUpProgress) || !data.followUpProgress.jof1_6) &&
        (!('jof1_7' in data.followUpProgress) || !data.followUpProgress.jof1_7) &&
        (!('jof1_8' in data.followUpProgress) || !data.followUpProgress.jof1_8);
    }

    function validContact(data) {
      return data.keys().hasOnly([
          'createdById', 'createdByName', 'name', 'phoneNumber', 'gender',
          'photoUrl', 'gospelStatus', 'responseStatuses', 'followUpProgress',
          'remarks', 'createdAt', 'updatedAt', 'linkedUserId', 'linkedAt', 'linkedByUid',
          'outreachPartnerIds', 'outreachPartnerNames', 'contactDate'
        ]) &&
        data.createdById is string && data.createdByName is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('contactDate' in data) ||
          (data.contactDate is string &&
            data.contactDate.size() == 10 &&
            data.contactDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))) &&
        data.gender in ['male', 'female'] &&
        data.gospelStatus in ['not_started', 'gospel_conversation', 'gospel_presentation'] &&
        data.responseStatuses is list && data.responseStatuses.size() <= 4 &&
        data.responseStatuses.hasOnly([
          'pray_receive_christ', 'already_christian', 'not_ready', 'say_yes_follow_up'
        ]) &&
        data.followUpProgress is map &&
        validOutreachPartnerFields(data) &&
        data.followUpProgress.keys().hasOnly([
          'vision_cast', 'jof1_1', 'jof1_2', 'jof1_3', 'jof1_4',
          'jof1_5', 'jof1_6', 'jof1_7', 'jof1_8'
        ]) &&
        (!('vision_cast' in data.followUpProgress) || data.followUpProgress.vision_cast is bool) &&
        (!('jof1_1' in data.followUpProgress) || data.followUpProgress.jof1_1 is bool) &&
        (!('jof1_2' in data.followUpProgress) || data.followUpProgress.jof1_2 is bool) &&
        (!('jof1_3' in data.followUpProgress) || data.followUpProgress.jof1_3 is bool) &&
        (!('jof1_4' in data.followUpProgress) || data.followUpProgress.jof1_4 is bool) &&
        (!('jof1_5' in data.followUpProgress) || data.followUpProgress.jof1_5 is bool) &&
        (!('jof1_6' in data.followUpProgress) || data.followUpProgress.jof1_6 is bool) &&
        (!('jof1_7' in data.followUpProgress) || data.followUpProgress.jof1_7 is bool) &&
        (!('jof1_8' in data.followUpProgress) || data.followUpProgress.jof1_8 is bool) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
        (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 2000)) &&
        (!('linkedUserId' in data) || data.linkedUserId is string) &&
        (!('linkedAt' in data) || data.linkedAt is timestamp) &&
        (!('linkedByUid' in data) || data.linkedByUid is string) &&
        (!('photoUrl' in data) || data.photoUrl == null ||
          (data.photoUrl is string && data.photoUrl.size() <= 2048)) &&
        (data.gospelStatus != 'not_started' || (data.responseStatuses.size() == 0 && hasNoJourneyProgress(data))) &&
        (!data.responseStatuses.hasAny(['not_ready']) ||
          (data.responseStatuses.size() == 1 && hasNoJourneyProgress(data))) &&
        (hasNoJourneyProgress(data) ||
          data.responseStatuses.hasAny(['say_yes_follow_up']));
    }

    match /contacts/{contactId} {
      // Fields fixed when the contact is created. No update may change them.
      function contactIdentityUnchanged() {
        return request.resource.data.createdById == resource.data.createdById &&
          request.resource.data.createdByName == resource.data.createdByName &&
          request.resource.data.createdAt == resource.data.createdAt;
      }

      function changedFields() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // The person who added the contact.
      function isContactCreator() {
        return isOwner(resource.data.createdById);
      }

      // The disciple who linked this contact.
      function isContactDiscipler() {
        return isOwner(resource.data.linkedByUid);
      }

      // The disciple this contact is about.
      function isContactDisciple() {
        return isOwner(resource.data.linkedUserId);
      }

      // A CLC friend listed as an outreach partner.
      function isContactPartner() {
        return request.auth.uid in resource.data.outreachPartnerIds;
      }

      allow read: if isMember();
      allow create: if isMember() &&
        request.resource.data.createdById == request.auth.uid &&
        validContact(request.resource.data);

      // One rule covers every editor, so the contact document is validated once
      // per request. A clause per role exhausted the rules expression budget
      // and denied legitimate updates.
      allow update: if isMember() &&
        contactIdentityUnchanged() &&
        (
          // Organizers and the discipler who linked the contact manage the
          // whole record, including the link fields.
          isOrganizer() ||
          isContactDiscipler() ||
          // The creator manages everything except the link fields.
          (isContactCreator() && !changedFields().hasAny(['linkedUserId', 'linkedAt', 'linkedByUid'])) ||
          // Outreach partners manage a limited set of fields.
          (isContactPartner() && changedFields().hasOnly([
            'name', 'contactDate', 'phoneNumber', 'gender', 'photoUrl', 'gospelStatus', 'responseStatuses',
            'followUpProgress', 'remarks', 'updatedAt'
          ])) ||
          // The disciple the contact is about may keep their own photo current.
          (isContactDisciple() && changedFields().hasOnly(['photoUrl', 'updatedAt']))
        ) &&
        validContact(request.resource.data);

      allow delete: if isMember() &&
        (isOwner(resource.data.createdById) || isAdmin());
    }

    // ------------------------------------------------------------------
    // Discipleship trees
    // ------------------------------------------------------------------

    function discipleshipTreeExists(treeId) {
      return exists(/databases/$(database)/documents/discipleshipTrees/$(treeId));
    }

    function validDiscipleshipNodeId(treeId, nodeType, refId, nodeId) {
      return nodeType in ['user', 'contact'] &&
        treeId is string && treeId.size() > 0 && treeId.size() <= 128 &&
        refId is string && refId.size() > 0 && refId.size() <= 128 &&
        nodeId == treeId + '__' + (nodeType == 'user' ? 'u_' : 'c_') + refId;
    }

    function validDiscipleshipNodeShape(data, treeId) {
      return data.keys().hasOnly([
          'treeId', 'nodeType', 'refId', 'displayName', 'photoUrl',
          'parentId', 'path', 'depth', 'childOrder', 'gospelStatus',
          'membershipStatus', 'addedByUid', 'addedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.treeId == treeId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
        (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048)) &&
        data.path is list && data.path.size() > 0 && data.path.size() <= 100 &&
        data.depth is int && data.depth == data.path.size() - 1 &&
        data.childOrder is number &&
        data.addedByUid is string &&
        (!('gospelStatus' in data) ||
          data.gospelStatus in ['not_started', 'gospel_conversation', 'gospel_presentation']) &&
        (!('membershipStatus' in data) ||
          data.membershipStatus in ['PENDING', 'APPROVED', 'REJECTED', 'FILTERED']) &&
        data.path[data.path.size() - 1] is string;
    }

    function validDiscipleshipParent(treeId, nodeId, parentId, path, depth) {
      return (parentId == null &&
          path == [nodeId] &&
          depth == 0) ||
        (parentId is string &&
          path.size() > 1 &&
          path[path.size() - 1] == nodeId &&
          depth == path.size() - 1 &&
          get(/databases/$(database)/documents/discipleshipNodes/$(parentId)).data.treeId == treeId &&
          get(/databases/$(database)/documents/discipleshipNodes/$(parentId)).data.path.size() + 1 == path.size() &&
          !(nodeId in get(/databases/$(database)/documents/discipleshipNodes/$(parentId)).data.path));
    }

    // Structural placement validation only — deliberately no document lookups.
    // Batched writes (and transactions) allow just 20 document access calls per
    // request, and a splice-repath touches one different parent path per
    // descendant, so get(parent) here would make large rewrites fail. Cycle
    // prevention lives in the transactional service; this still guarantees a
    // well-formed path for every stored node.
    function validDiscipleshipPlacement(data, nodeId) {
      return (data.parentId == null || data.parentId is string) &&
        data.path is list && data.path.size() > 0 && data.path.size() <= 100 &&
        data.path[data.path.size() - 1] == nodeId &&
        data.depth is int && data.depth == data.path.size() - 1 &&
        (data.parentId != null || (data.path.size() == 1 && data.depth == 0));
    }

    match /discipleshipTrees/{treeId} {
      allow read: if isAuthenticated();
      // The tree shell is admin-only end to end: creating one, renaming it and
      // deleting it all rewrite everyone's view of it. Placing people *inside*
      // a tree is a separate permission — organizers manage those under
      // `discipleshipNodes` below.
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'name', 'description', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 &&
        (!('description' in request.resource.data) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 500)) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdByName is string;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /discipleshipNodes/{nodeId} {
      allow read: if isAuthenticated();
      // Creates are single-document requests (10 access-call budget), so the
      // full parent-chain check is affordable here. Adds/imports go one at a
      // time; only bulk rewrites (update/delete) need the lighter validation.
      allow create: if isOrganizer() &&
        validDiscipleshipNodeId(request.resource.data.treeId, request.resource.data.nodeType, request.resource.data.refId, nodeId) &&
        discipleshipTreeExists(request.resource.data.treeId) &&
        validDiscipleshipNodeShape(request.resource.data, request.resource.data.treeId) &&
        validDiscipleshipPlacement(request.resource.data, nodeId) &&
        validDiscipleshipParent(
          request.resource.data.treeId,
          nodeId,
          request.resource.data.parentId,
          request.resource.data.path,
          request.resource.data.depth);
      // Move and splice-repath both land here: identity fields are immutable.
      // Placement is validated structurally — the transactional service owns
      // cycle prevention and prefix consistency, since a batched repath cannot
      // resolve per-node parent documents within Firestore's access-call budget.
      allow update: if isOrganizer() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'parentId', 'path', 'depth', 'childOrder', 'updatedAt',
          'displayName', 'photoUrl', 'gospelStatus', 'membershipStatus', 'addedByName'
        ]) &&
        resource.data.treeId == request.resource.data.treeId &&
        resource.data.nodeType == request.resource.data.nodeType &&
        resource.data.refId == request.resource.data.refId &&
        resource.data.addedByUid == request.resource.data.addedByUid &&
        validDiscipleshipNodeId(request.resource.data.treeId, request.resource.data.nodeType, request.resource.data.refId, nodeId) &&
        validDiscipleshipNodeShape(request.resource.data, request.resource.data.treeId) &&
        validDiscipleshipPlacement(request.resource.data, nodeId);
      allow delete: if isOrganizer();
    }
  }
}
